#include <iostream>
using namespace std;
int main() {
    int productCode;
    cout << "--- BREAKFAST MENU ---" << endl;
    cout << "Select a product number:" << endl;
    cout << "1. Coffee - 1.20€" << endl;
    cout << "2. Cappuccino - 1.50€" << endl;
    cout << "3. Croissant - 1.00€" << endl;
    cout << "4. Fruit Juice - 1.80€" << endl;
    cout << "Selection: ";
    cin >> productCode;
    switch (productCode) {
        case 1:
            cout << "You chose: Coffee - 1.20€" << endl;
            break;
        case 2:
            cout << "You chose: Cappuccino - 1.50€" << endl;
            break;
        case 3:
            cout << "You chose: Croissant - 1.00€" << endl;
            break;
        case 4:
            cout << "You chose: Fruit Juice - 1.80€" << endl;
            break;
        default:
            cout << "Invalid numerical value. Please try again." << endl;
            break;
    }
    return 0;
}
