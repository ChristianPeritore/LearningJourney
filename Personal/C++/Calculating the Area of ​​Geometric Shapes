#include <iostream>
#include <cmath>
using namespace std;
int main () {
    int n;
    float r, a, b, h;
    const float π = 3.14;
    cout<<"Enter a number to calculate the area of a geometric shape (1 circle - 2 rectangle - 3 triangle)"<<endl;
    cin>>n;
    switch (n) {
        case 1:
        cout<<"Enter the radius"<<endl;
        cin>>r;
        a = π * pow(r, 2);
        cout<<"The area is "<<a<<endl;
        break;
        case 2:
        cout<<"Enter base and height"<<endl;
        cin>>b>>h;
        a = b * h;
        cout<<"The area is "<<a<<endl;
        break;
        case 3:
        cout<<"Enter base and height"<<endl;
        cin>>b>>h;
        a = (b * h) / 2;
        cout<<"The area is "<<a<<endl;
        break;
        default:
        cout<<"Error"<<endl;
        break;
    }
    return 0;
}    
